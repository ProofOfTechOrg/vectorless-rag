{
  "name": "vectorless-rag",
  "version": "0.2.0",
  "description": "Self-hosted vectorless RAG for grounded question answering over local PDFs",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/ProofOfTechOrg/vectorless-rag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProofOfTechOrg/vectorless-rag.git"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @vectorless-rag/web dev",
    "lint:web": "pnpm --filter @vectorless-rag/web lint",
    "typecheck:web": "pnpm --filter @vectorless-rag/web typecheck",
    "test:web": "pnpm --filter @vectorless-rag/web test",
    "build:web": "pnpm --filter @vectorless-rag/web build",
    "test:e2e": "pnpm --filter @vectorless-rag/web test:e2e",
    "react-doctor": "pnpm --filter @vectorless-rag/web run react-doctor",
    "react-doctor:diff": "pnpm --filter @vectorless-rag/web run react-doctor:diff",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
